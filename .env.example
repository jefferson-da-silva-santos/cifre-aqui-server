# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (Neon PostgreSQL)
DATABASE_URL="postgresql://app_user:CHANGE_ME@ep-xxxx.neon.tech/cifreaqui_db?sslmode=require&connection_limit=10&pool_timeout=20"

# JWT
JWT_ACCESS_SECRET=troque_por_uma_string_aleatoria_de_pelo_menos_32_caracteres
JWT_REFRESH_SECRET=troque_por_outra_string_aleatoria_de_pelo_menos_32_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173,https://cifreaqui.com.br

# payment-system-mp (backend próprio de pagamentos)
PAYMENT_API_BASE_URL=https://payment-system-mp.internal/api
PAYMENT_PUBLIC_KEY=CHANGE_ME
PAYMENT_API_KEY=CHANGE_ME
PAYMENT_WEBHOOK_SECRET=CHANGE_ME
# Ativa o provedor mock (sem chamadas HTTP reais) para desenvolvimento local
PAYMENT_MOCK_MODE=true

# Preços (em BRL, controlados por env para facilitar ajuste comercial sem deploy de código)
PRICE_CRIACAO=5.00
PRICE_EDICAO=3.00

# Puppeteer / geração de PDF
PDF_TIMEOUT_MS=30000

# Observabilidade
PROMETHEUS_PORT=9464

# Contato de suporte (reembolso manual — seção 11.5 do README do produto)
SUPPORT_WHATSAPP_URL=https://wa.me/5581900000000

# --- Cookie de refresh -------------------------------------------------------
# lax  -> frontend e API no mesmo site (inclui localhost em portas diferentes)
# none -> dominios diferentes; exige HTTPS dos dois lados
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.seudominio.com

# --- PDF ---------------------------------------------------------------------
# Vazio usa o Chromium que o puppeteer baixou. Se aparecer "Could not find
# Chrome", rode:  npx puppeteer browsers install chrome
# Ou aponte aqui para um Chrome ja instalado:
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Linux:   /usr/bin/google-chrome-stable
# PUPPETEER_EXECUTABLE_PATH=
